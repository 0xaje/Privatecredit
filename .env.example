# Runtime mode: live is the default; local-test must be explicit.
APP_MODE=live

# Creditcoin CC3 testnet
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031
CREDITCOIN_PROOF_BUILDER_URL=https://proof-gen-api.cc3-testnet.creditcoin.network/
CREDITCOIN_EXPLORER=https://creditcoin.blockscout.com

# Deployment-only signer. Never use this for borrower/lender/user actions.
DEPLOYER_PRIVATE_KEY=

# Contract addresses; core addresses are in config/deployments.json.
USC_VERIFIER_ADDR=
ELIGIBILITY_REGISTRY_ADDRESS=
ARTEFACT_REGISTRY_ADDR=
REPAYMENT_REGISTRY_ADDR=
CAPACITY_MANAGER_ADDR=
LOAN_VAULT_ADDR=
MARKETPLACE_ADDR=

# Source-chain USC configuration.
SOURCE_CHAIN_RPC_URL=
SOURCE_CHAIN_ID=11155111
SOURCE_CHAIN_KEY=1
SOURCE_TOKEN_ADDRESS=
ATTESTCOIN_HTTP_TIMEOUT_MS=10000
ATTESTCOIN_POLL_INTERVAL_MS=15000
ATTESTCOIN_WAIT_TIMEOUT_MS=900000

PORT=3001
